# Настройки сервера INNSIDER. Копия с вашими значениями: /etc/sut/api.env (права 600, владелец root)
PORT=3000
HOST=127.0.0.1
ALLOWED_ORIGINS=https://inn-sider.ru,https://www.inn-sider.ru,https://innfact.ru,https://www.innfact.ru,https://fin-check.shop,https://www.fin-check.shop

# Проверка организаций и разбор (те же ключи, что сейчас на Render)
DADATA_TOKEN=
GEMINI_API_KEY=
# Разбор через Алису (Yandex AI Studio), прямо из России. Если оба значения заданы — используется Алиса, а не Gemini.
# Yandex Cloud → каталог → сервисный аккаунт с ролью ai.languageModels.user → API-ключ
YANDEX_AI_KEY=
YANDEX_FOLDER_ID=
# YANDEX_AI_MODEL=aliceai-llm-flash   # дешевле; по умолчанию aliceai-llm
# Google не пускает к Gemini с российских адресов: разбор пересылается на сервер за рубежом (только ИНН организации)
AI_UPSTREAM_URL=https://sut-api.onrender.com

# Открытые данные ФНС (scripts/fns-import.mjs, обновляются по cron 26-го числа)
FNS_DB=/var/lib/sut/fns.db

# Аккаунты: база в России (152-ФЗ)
ACCOUNTS_DB=/var/lib/sut/sut.db
SITE_URL=https://inn-sider.ru
PUBLIC_API_URL=https://api.inn-sider.ru
COOKIE_DOMAIN=.inn-sider.ru

# Вход через Яндекс ID: oauth.yandex.ru → приложение, Redirect URI https://api.inn-sider.ru/auth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Вход и уведомления через Telegram: бот от @BotFather, в нём /setdomain → inn-sider.ru
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=

# Почта для кодов входа и уведомлений (например, Яндекс Почта с паролем приложения)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Подписка INNSIDER Pro через ЮKassa (yookassa.ru → Интеграция → Ключи API). Без этих двух строк всё бесплатно.
# HTTP-уведомления в ЮKassa: https://api.inn-sider.ru/billing/yookassa, события payment.succeeded и payment.canceled
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Кассовые чеки 54-ФЗ через ЮKassa — для ИП на УСН (магазин должен быть подключён к облачной кассе партнёра ЮKassa)
YOOKASSA_RECEIPT=1
# 2 — УСН «доходы», 3 — УСН «доходы минус расходы»
YOOKASSA_TAX_SYSTEM=2
# Автопродление — только после того, как ЮKassa одобрит автоплатежи для магазина
# YOOKASSA_RECURRING=1
# FREE_COURTS_PER_DAY=3        # бесплатных новых проверок судов в день
# DATANEWTON_PRO_UNITS=100     # запас единиц DataNewton в день для подписчиков сверх общего лимита
