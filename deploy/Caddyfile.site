# Сайт sverkainn.ru на этом сервере: статические страницы из /var/www/fin-check.shop (имя папки осталось от старого адреса),
# страницы компаний, их картинки и карта сайта компаний — от server/index.mjs. Старый адрес fin-check.shop
# и прежний innfact.ru навсегда перенаправляются на sverkainn.ru (api.fin-check.shop и api.innfact.ru продолжают работать).
# Подключается командой deploy/move-domain.sh.
sverkainn.ru {
	encode zstd gzip
	@company path_regexp company ^/(organizacii/[0-9]{10,12}(/|/og\.png)?|sitemap-companies(-[0-9]+)?\.xml)$
	handle @company {
		reverse_proxy 127.0.0.1:3000
	}
	handle {
		root * /var/www/fin-check.shop
		@static path *.css *.js *.woff2 *.svg *.png *.ico *.webmanifest
		header @static Cache-Control "public, max-age=604800"
		try_files {path} {path}/index.html
		file_server
	}
	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			root * /var/www/fin-check.shop
			rewrite * /404.html
			file_server
		}
	}
}
www.sverkainn.ru {
	redir https://sverkainn.ru{uri} permanent
}
api.sverkainn.ru, api.innfact.ru {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}
innfact.ru, www.innfact.ru, fin-check.shop, www.fin-check.shop {
	redir https://sverkainn.ru{uri} permanent
}
