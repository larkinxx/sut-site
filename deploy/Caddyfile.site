# Сайт inn-sider.ru на этом сервере: статические страницы из /var/www/fin-check.shop (имя папки осталось от старого адреса),
# страницы компаний, их картинки и карта сайта компаний — от server/index.mjs. Старый адрес fin-check.shop
# и прежние innfact.ru, sverkainn.ru и inn-saider.ru (то же название на слух) навсегда перенаправляются на inn-sider.ru (api.fin-check.shop и api.innfact.ru продолжают работать).
# Подключается командой deploy/move-domain.sh.
inn-sider.ru {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	# защита посетителя: не встраивать сайт в чужую рамку (кликджекинг), не угадывать тип файла,
	# не отдавать полный адрес чужим сайтам, запретить доступ к камере, микрофону и геолокации
	header X-Frame-Options "DENY"
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "strict-origin-when-cross-origin"
	header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	header -Server
	@company path_regexp company ^/(organizacii/[0-9]{10,12}(/|/og\.png)?|sitemap-companies(-[0-9]+)?\.xml|otrasli(/.*)?|sitemap-otrasli\.xml|sertifikat(/.*)?|issledovaniya(/.*)?)$
	handle @company {
		reverse_proxy 127.0.0.1:3000
	}
	handle {
		root * /var/www/fin-check.shop
		@static {
			path *.css *.js *.woff2 *.svg *.png *.ico *.webmanifest
			not query v=*
		}
		header @static Cache-Control "public, max-age=604800"
		# стили и скрипты с отпечатком версии (?v=…) не меняются никогда — браузер хранит их год и не перепроверяет
		@versioned {
			path *.css *.js
			query v=*
		}
		header @versioned Cache-Control "public, max-age=31536000, immutable"
		# одна страница — один адрес: /yurist → /yurist/, /x/index.html → /x/ (иначе поисковик видит дубли)
		@idx path_regexp idx ^(.*/)index\.html$
		redir @idx {re.idx.1}{?query} permanent
		@dir {
			not path */
			file {path}/index.html
		}
		redir @dir {path}/{?query} permanent
		try_files {path} {path}/index.html
		file_server
	}
	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			root * /var/www/fin-check.shop
			rewrite * /404.html
			file_server
		}
		# сервер сайта не отвечает (перезапуск, сбой): без этого Caddy отдаёт пустой 502 без типа, и iPhone предлагает «скачать файл»
		@unavailable expression {err.status_code} >= 500
		handle @unavailable {
			root * /var/www/fin-check.shop
			rewrite * /503.html
			header Cache-Control "no-store"
			file_server {
				status {err.status_code}
			}
		}
	}
}
www.inn-sider.ru {
	redir https://inn-sider.ru{uri} permanent
}
api.inn-sider.ru, api.innfact.ru {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}
inn-saider.ru, www.inn-saider.ru, sverkainn.ru, www.sverkainn.ru, innfact.ru, www.innfact.ru, fin-check.shop, www.fin-check.shop {
	redir https://inn-sider.ru{uri} permanent
}
