{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous-git.mjs\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run -s lint)",
      "Bash(npm run lint)",
      "Bash(npm run -s test:server)",
      "Bash(npm run test:server)",
      "Bash(npm run -s check)",
      "Bash(npm run check)",
      "Bash(git fetch *)",
      "mcp__github__actions_list",
      "mcp__github__get_job_logs",
      "mcp__github__pull_request_read",
      "mcp__Gmail__search_threads",
      "mcp__Claude_Code_Remote__read_documentation"
    ]
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail",
        "ref": "v4.10.0"
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  }
}
